package conversation_analysis
templ feedback() {
    <div class="mt-4">
        <div class="card bg-dark border-secondary">
            <div class="card-header text-indigo fw-bold">Teacher Feedback</div>
            <div class="card-body">
                <div id="feedback" class="p-2 text-light">Generating feedback…</div>
            </div>
        </div>
    </div>
    <!-- marked CDN -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
}
