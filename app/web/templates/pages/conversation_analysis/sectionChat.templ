package conversation_analysis
import (
    up "vox/internal/userProfile"
    "vox/internal/ai"
)
templ chat(userProfile *up.UserProfile, messages []ai.ChatMessage) {
    <div class="card bg-dark border-secondary mb-4">
        <div class="card-header text-indigo fw-bold">History</div>
        <div class="card-body p-0">
            <div id="chat-history" class="p-3" style="max-height:60vh; overflow-y:auto;">
                for _, m := range messages {
                    <div class={ "d-flex mb-2", templ.KV(templ.Class("justify-content-end"), m.Role == "user"), templ.KV(templ.Class("justify-content-start"), m.Role != "user") }>
                        <div class={ "px-3 py-2 rounded-3",
                            templ.KV(templ.Class("bg-secondary bg-opacity-25 text-light rounded-start-4 rounded-end-0"), m.Role == "user"),
                            templ.KV(templ.Class("bg-secondary bg-opacity-25 text-light rounded-end-4 rounded-start-0"), m.Role != "user") }>
                            <strong class="me-2">{ m.Role }:</strong>
                            <span class="d-block">{ m.Content }</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}
