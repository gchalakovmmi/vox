package signin

templ panel(){
	<div class="row d-flex justify-content-center">
		<div class="col-5">
			<h1>Sign In</h1>
			<form>
				<div class="mb-3">
					<label for="email" class="form-label">Email address</label>
					<input type="email" class="form-control" id="email">
				</div>
				<div class="mb-3">
					<label for="password" class="form-label">Password</label>
					<input type="password" class="form-control" id="password">
				</div>
				<button type="submit" class="btn btn-primary">Submit</button>
			</form>
			<!-- Centered Google Button -->
			<div class="d-flex justify-content-center mt-3">
				<button class="btn btn-light btn-lg d-flex align-items-center shadow-sm border rounded-pill px-4 py-2">
					<img src="/web/static/images/google-logo.webp" alt="Google Logo" class="me-2" width="24" height="24">
					<span>Sign In with Google</span>
				</button>
			</div>
		</div>
	</div>
}
