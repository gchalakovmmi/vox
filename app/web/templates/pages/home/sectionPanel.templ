package home
import (
    up "vox/internal/userProfile"
)
templ panel(userProfile *up.UserProfile) {
    <div class="row justify-content-center">
        <div class="col-lg-6 text-center">
            <h1 class="fw-bold text-indigo mb-3">Welcome back, { userProfile.FirstName }!</h1>
            <p class="lead mb-4">Ready for today’s practice?</p>
            <a href="/conversation" class="btn btn-secondary btn-lg px-5">Start Conversation</a>
        </div>
    </div>
}
